# Copy to .env and fill in. Never commit .env.

# --- LLM (Challenge 1: MUST be Vultr Serverless Inference) ---
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
# A model with tool calling. List available models: curl http://localhost:8300/api/models
LLM_MODEL=
# Leave LLM_API_KEY empty to run in SCRIPTED MODE (pipeline test only, banner shown in UI).
# Optional sampling temperature. Leave unset for Claude (4.7+ rejects values < 1); e.g. 0.2 for Vultr models.
# LLM_TEMPERATURE=
#
# DEVELOPMENT ONLY (not allowed for the Challenge 1 submission): Claude via its OpenAI-compatible endpoint
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=<Claude API key>
# LLM_MODEL=claude-opus-5-5

# --- Public URLs (on a Vultr VM use http://<VM_IP>:port) ---
PUBLIC_URL=http://localhost:8300
PREVIEW_PUBLIC_URL=http://localhost:8301
LIVE_PUBLIC_URL=http://localhost:8080

# --- Demo live site admin (wp-admin login: pemilik) ---
LIVE_ADMIN_PASSWORD=senja-demo-2026

# --- Optional ---
# Domains a feature may call once the owner approves them (comma separated). Empty = none.
ALLOWED_DOMAINS=
# SANDBOX_MEMORY=512m
# SANDBOX_CPUS=1
# AGENT_MAX_STEPS=16
