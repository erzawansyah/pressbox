# Copy to .env and fill in. Never commit .env.

# --- Agent LLM: Vultr Serverless Inference (required for Challenge 1) ---
LLM_BASE_URL=https://api.vultrinference.com/v1
# A Serverless Inference subscription key (not the Vultr account API key).
LLM_API_KEY=
# A model with tool calling, e.g. deepseek-v4.1-flash-1017. List models: curl http://localhost:8300/api/models
LLM_MODEL=deepseek-v4.1-flash-1017
# Optional sampling temperature. Leave unset for Claude (4.7+ rejects values below 1).
# LLM_TEMPERATURE=
# Leave LLM_API_KEY empty to run in scripted mode (pipeline test only; the UI says so).

# --- Public demo access (only enforced when LLM_API_KEY is set) ---
# Code for judges; unlocks a shared quota on the key above.
JUDGE_ACCESS_CODE=
JUDGE_TASK_LIMIT=40
# Let visitors without a code use their own Vultr Serverless Inference key.
ALLOW_OWN_KEY=true

# --- Vultr account API key (only for provisioning scripts; never given to the app's agent) ---
VULTR_API_KEY=

# --- Public URLs (on a Vultr VM use http://<VM_IP>:port) ---
PUBLIC_URL=http://localhost:8300
PREVIEW_PUBLIC_URL=http://localhost:8301
LIVE_PUBLIC_URL=http://localhost:8080

# --- Demo production site (wp-admin user: owner) ---
LIVE_ADMIN_PASSWORD=senja-demo-2026

# --- Optional ---
# Domains a feature may call once the owner approves them (comma separated). Empty means none.
ALLOWED_DOMAINS=
# SANDBOX_MEMORY=512m
# SANDBOX_CPUS=1
# AGENT_MAX_STEPS=20
